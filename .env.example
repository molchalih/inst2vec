# inst2vec environment variables.
# Copy this file to `.env` and fill in real values.
# Non-secret tunables live in config.toml, not here.

# ── Databases ────────────────────────────────────────────────
# Two-DB design (PII isolation):
#   - DATABASE_URL holds anonymous data: users, clips, music, downloads,
#     clip_embeddings, user_embeddings, user_clusters, cluster_runs,
#     user_stats, clip_filter_scratch, stage_state.
#   - IDENTITY_DB_URL holds PII only: user_identities, clip_identities
#     (Instagram API pk ↔ internal id maps).
# SQLite for local dev; swap to Postgres URLs in production.
DATABASE_URL=sqlite:///data/inst2vec.db
IDENTITY_DB_URL=sqlite:///data/identity_map.db
# Separate read-optimised serving store the offload script writes and the
# atlas API reads. Defaults to a local SQLite file. These three URLs drive the
# three Alembic environments: `alembic -n {main,identity,serving} upgrade head`.
SERVING_DATABASE_URL=sqlite:///data/serving.db

# ── Atlas read API (optional) ────────────────────────────────
# services/atlas_api serves the version-6 frontend contract from the serving
# DB above. ATLAS_API_TOKEN, when set, gates every endpoint behind a Bearer
# token; leave blank for open read access. ATLAS_API_CORS_ORIGIN restricts
# browser access to the GitHub Pages origin (blank = no CORS header).
ATLAS_API_TOKEN=
ATLAS_API_CORS_ORIGIN=

# ── Instagram ingest (HikerAPI) ──────────────────────────────
HIKER_API_KEY=

# ── Model downloads (Hugging Face) ───────────────────────────
HUGGINGFACE_TOKEN=

# ── Clip embedder coordinator (optional) ─────────────────────
# Shared secret gating the embedding coordinator and the worker pods
# that connect to it. Leave blank to run Qwen3-VL embeddings locally
# from ./models/ without a coordinator.
EMBEDDER_TOKEN=

# ── Object store for the upload stage (optional) ─────────────
# Required when the storage bucket is set. The upload stage writes selected
# videos here; for RunPod this is the network volume's S3 endpoint, so the
# clips land on the same volume the pods mount. S3-compatible.
# RunPod endpoint format: https://s3api-<datacenter>.runpod.io (lowercased),
# e.g. EU-RO-1 -> https://s3api-eu-ro-1.runpod.io. Keys: RunPod → Settings → S3.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
# Storage bucket + SigV4 region. Default to the RunPod volume id + datacenter
# below, so usually leave blank. Set only to point at a non-RunPod bucket.
STORAGE_BUCKET=
STORAGE_REGION=

# ── Gemini Embedding 2 case (optional) ───────────────────────
# Required only when [embeddings].gemini_enabled = true in config.toml.
GEMINI_API_KEY=

# ── RunPod embedding pod fleet (optional) ────────────────────
# Set these (plus EMBEDDER_TOKEN, OBJECT_STORE_*, and a reachable coordinator
# host) to auto-deploy GPU pods during the Clip Embeddings stage.
# RUNPOD_POD_COUNT=0 runs embeddings on the orchestrator GPU only.
RUNPOD_API_KEY=
RUNPOD_POD_COUNT=0
# The region-pinned network volume and its datacenter (RunPod → Storage).
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_DATA_CENTER_ID=
# Private image: leave RUNPOD_IMAGE blank and set RUNPOD_TEMPLATE_ID to a
# RunPod template that carries the registry pull credential. Public image:
# set RUNPOD_IMAGE and leave the template blank.
RUNPOD_IMAGE=
RUNPOD_TEMPLATE_ID=
# GPU selection. Empty type -> auto-fetch in-stock GPUs in the DC under the
# price cap meeting the floors, cheapest-first; or pin one type. Blank vars
# fall back to config.toml defaults (cap 0.80, vram 24, ram 30).
RUNPOD_GPU_TYPE_ID=
RUNPOD_GPU_MAX_PRICE_HR=
RUNPOD_GPU_MIN_VRAM_GB=
RUNPOD_GPU_MIN_RAM_GB=
# How pods reach this orchestrator's coordinator ([embeddings].coordinator_bind_port).
# Bare host:port defaults to http:// (raw port-forward, e.g. 1.2.3.4:8765).
# Prefix with a scheme for a TLS tunnel — recommended, since the bearer token
# is otherwise cleartext. scripts/start.sh auto-fills this from a quick tunnel
# when left blank (e.g. https://abc.trycloudflare.com).
COORDINATOR_PUBLIC_HOST=
