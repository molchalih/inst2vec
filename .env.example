# inst2vec environment variables.
# Copy this file to `.env` and fill in real values.
# Non-secret tunables live in config.toml, not here.

# ── Databases ────────────────────────────────────────────────
# Two-DB design (PII isolation):
#   - DATABASE_URL holds anonymous data: users, clips, music, downloads,
#     clip_embeddings, user_embeddings, user_clusters, cluster_runs,
#     user_stats, clip_filter_scratch, stage_state.
#   - IDENTITY_DB_URL holds PII only: user_identities, clip_identities
#     (Instagram API pk ↔ internal id maps).
# SQLite for local dev; swap to Postgres URLs in production.
DATABASE_URL=sqlite:///data/inst2vec.db
IDENTITY_DB_URL=sqlite:///data/identity_map.db
# Separate read-optimised serving store the offload script writes and the
# atlas API reads. Defaults to a local SQLite file. These three URLs drive the
# three Alembic environments: `alembic -n {main,identity,serving} upgrade head`.
SERVING_DATABASE_URL=sqlite:///data/serving.db

# ── Atlas read API (optional) ────────────────────────────────
# services/atlas_api serves the version-6 frontend contract from the serving
# DB above. ATLAS_API_TOKEN, when set, gates every endpoint behind a Bearer
# token; leave blank for open read access. ATLAS_API_CORS_ORIGIN restricts
# browser access to the GitHub Pages origin (blank = no CORS header).
ATLAS_API_TOKEN=
ATLAS_API_CORS_ORIGIN=

# ── Instagram ingest (HikerAPI) ──────────────────────────────
HIKER_API_KEY=

# ── Model downloads (Hugging Face) ───────────────────────────
# Qwen3-VL embeddings run locally from ./models/ on the GPU host.
HUGGINGFACE_TOKEN=
