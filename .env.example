# inst2vec environment variables.
# Copy this file to `.env` and fill in real values.
# Non-secret tunables live in config.toml, not here.

# ── Databases ────────────────────────────────────────────────
# Two-DB design (PII isolation):
#   - DATABASE_URL holds anonymous data: users, clips, music, downloads,
#     clip_embeddings, user_embeddings, user_clusters, cluster_runs,
#     user_stats, clip_filter_scratch, stage_state.
#   - IDENTITY_DB_URL holds PII only: user_identities, clip_identities
#     (Instagram API pk ↔ internal id maps).
# SQLite for local dev; swap to Postgres URLs in production.
DATABASE_URL=sqlite:///data/inst2vec.db
IDENTITY_DB_URL=sqlite:///data/identity_map.db

# ── Instagram ingest (HikerAPI) ──────────────────────────────
HIKER_API_KEY=

# ── Model downloads (Hugging Face) ───────────────────────────
HUGGINGFACE_TOKEN=

# ── Remote clip embedder (optional) ──────────────────────────
# Required when [embeddings].provider = "remote" in config.toml.
# Leave blank to run Qwen3-VL embeddings locally from ./models/.
EMBEDDER_REMOTE_URL=
EMBEDDER_TOKEN=

# ── Object store for the upload stage (optional) ─────────────
# Required when [storage].bucket is set in config.toml. The upload stage
# pushes selected videos here and the remote embedder pulls from the same
# bucket. S3-compatible (AWS S3, Cloudflare R2, MinIO, etc.).
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# ── Gemini Embedding 2 case (optional) ───────────────────────
# Required only when [embeddings].gemini_enabled = true in config.toml.
GEMINI_API_KEY=
