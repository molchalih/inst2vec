# hiker config
HIKER_API_KEY=

# arc cloud credentials
ARC_ACCESS_KEY=
ARC_SECRET_KEY=
ARC_HOST=

# spotify credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# huggingface credentials
HUGGINGFACE_TOKEN=

# dataset configuration
DATABASE_URL=sqlite:///data/inst2vec.db
DATA_CSV_PATH=data/data.csv
BATCH_SIZE=9999
MAX_CLIPS=5
MAX_DOWNLOAD_ATTEMPTS=3
DOWNLOAD_RETRY_DELAY=2

# final dataset gating (phase 0.5, right after parse)
FINALIZE_TARGET_CLIPS_PER_USER=4
FINALIZE_REQUIRE_MIN_TEXT_CLIPS=0
FINALIZE_PASS_A_RECOMPUTE_FROM_SCRATCH=1
FINALIZE_GLOBAL_MIN_PLAYS=0
FINALIZE_GLOBAL_MIN_PLAYS_PERCENTILE=5
FINALIZE_CREATOR_ROBUST_Z_THRESHOLD=-2.5
FINALIZE_CREATOR_MIN_CLIPS=5

# embeddings stage policy
EMBEDDINGS_EXCLUDE_DISQUALIFIED_USERS=1

# speech configuration
AUDIO_FINGERPRINT_CONFIDENCE=0.8
WHISPER_MODEL=large-v3-turbo
SPEECH_LOGPROB_THRESHOLD=-0.8
SPEECH_COMPRESSION_THRESHOLD=2.4
SPEECH_MIN_MEANINGFUL_CHARS=8

# music configuration
MUSIC_HTTP_TIMEOUT=20
SPOTIFY_SEARCH_LIMIT=5
SPOTIFY_TOKEN_SKEW_SECONDS=30
SPOTIFY_COMMIT_EVERY=50
SPOTIFY_PROGRESS_EVERY=10
SPOTIFY_REQUEST_TIMEOUT=8

# reccobeats configuration
RECCOBEATS_BATCH_SIZE=20
RECCOBEATS_DELAY_MIN=2
RECCOBEATS_DELAY_MAX=3

# manual processing configuration
MANUAL_FEATURES_MAX_SECONDS=20
MANUAL_FEATURES_MAX_MB=5
MANUAL_FEATURES_SAMPLE_RATE=44100
MANUAL_FEATURES_MP3_BITRATE=128k
MANUAL_FEATURES_COMMIT_EVERY=20

# clustering grid search
CLUSTERING_UMAP_N_COMPONENTS=10 15 20 30 35 40
CLUSTERING_UMAP_N_NEIGHBORS=10 15 30
CLUSTERING_UMAP_MIN_DIST=0.0 0.05
CLUSTERING_UMAP_METRICS=cosine euclidean correlation
CLUSTERING_UMAP2D_N_NEIGHBORS=15
CLUSTERING_UMAP2D_MIN_DIST=0.1
CLUSTERING_UMAP2D_METRICS=cosine euclidean
CLUSTERING_HDBSCAN_MIN_CLUSTER_SIZE=10 15 25
CLUSTERING_HDBSCAN_SELECTION=eom leaf
# HDBSCAN runs on pass-1 UMAP embedding; distance is always euclidean (not configurable).
CLUSTERING_RANDOM_STATE=42
# Grid search + validation scoring: concurrent combos / rows (threads). Each task uses single-thread UMAP.
# Default 1 = sequential.
CLUSTERING_GRID_WORKERS=1

# clustering validation (phase 6b)
VALIDATION_MAX_NOISE_RATIO=0.3
VALIDATION_MIN_CLUSTERS=3
VALIDATION_MAX_CLUSTERS=20
VALIDATION_PLATEAU_DROP_THRESHOLD=0.05
