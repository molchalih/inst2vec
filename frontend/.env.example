# Frontend environment variables (Vite). Copy to `.env` to override.

# Data source toggle. Leave UNSET (the default) to load the atlas entirely from
# the static JSON tree under public/data/ — this is what the GitHub Pages
# deploy uses. Set it to the read-only atlas API root (must end with `/`) to
# load BOTH the bulk atlas and per-id detail panes over HTTP instead:
#
#   VITE_API_BASE_URL=https://your-atlas-api.example.com/
#
# The API mirrors the static paths 1:1, so this single switch flips both data
# planes with no other change.
VITE_API_BASE_URL=
