# Environment
.venv/
.env

# Data folder (root-level Python data; not frontend/src/data)
/data/
!frontend/public/data/

# Swipe-anchor app-store runtime DB + activity log (never commit runtime state)
swipe_anchor/backend/data/
*.db
*.db-wal
*.db-shm

# Model weights & checkpoints
models/
checkpoints/
*.safetensors

# docs/: only docs/assets is tracked in git. Everything else (reporting source,
# quarto paper sources & renders, scratch prototypes, generated bits) is local-only.
/docs/*
!/docs/assets/

# uv
uv.lock.bak

# Worktrees
.worktrees/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.uv-cache/

# IDEs & OS
.vscode/
.cursor/
.idea/
.DS_Store

# Quarto
/.quarto/
**/*.quarto_ipynb*

# Script outputs
scripts/output/

# Pipeline run logs (start.sh tees here)
logs/

# Local-only maintainer tooling: cluster analysis (scripts + its tests)
scripts/cluster_analysis/
tests/cluster_analysis/

# Frontend build artefacts
frontend/node_modules/
frontend/dist/
frontend/coverage/
swipe_anchor/frontend/node_modules/
swipe_anchor/frontend/dist/
swipe_anchor/frontend/coverage/

# One-off research graph generator (scratch)
scripts/make_research_graphs.py

**/*.quarto_ipynb

# SonarScanner config + work dir (kept local, not tracked)
sonar-project.properties
.scannerwork/

# Reporting tests — exercise the local-only (gitignored) docs/reporting
# package, so they are kept local and out of CI.
tests/*quarto*
tests/test_clip_labels_example_table.py
tests/reporting/
